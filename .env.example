# 실제 API 로 dev 실행. 이 값이 없으면 `npm run dev` 는 mock 으로 동작한다.
# (.env.local 에 복사해서 사용. production 빌드는 Dockerfile 의 build-arg 로 주입)
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# 강제로 mock 사용 (API_BASE 가 있어도 mock)
# NEXT_PUBLIC_USE_MOCK=true

# Cloudflare Turnstile. dev 에서 비워 두면 Cloudflare 테스트 키(1x00...AA)를 쓴다.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
